# ============================================================
# AI-Powered Career Guidance — MASTER environment template
# ------------------------------------------------------------
# Each service reads its own .env file:
#   backend/.env    <- copy the Backend section below
#   frontend/.env   <- copy the Frontend section below
# (Per-service templates also exist: backend/.env.example,
#  frontend/.env.example)
# Real .env files are git-ignored — never commit secrets.
# ============================================================

# ========================== BACKEND (backend/.env) ==========================

# ---- Flask ----
FLASK_APP=run.py
FLASK_ENV=development
# API_HOST=127.0.0.1
# API_PORT=5000
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ---- JWT ----
# Use a random value of at least 32 characters (HS256).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600

# ---- Database (Supabase PostgreSQL) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Use the shared pooler (IPv4-friendly):
#   port 6543 = transaction mode (runtime)
#   port 5432 = session mode (schema creation / migrations)
# Replace <PASSWORD> and <PROJECT-REF>; URL-encode special characters in the
# password (e.g. "@" -> "%40"). Do NOT add Prisma's "?pgbouncer=true" (psycopg
# rejects it; prepared statements are disabled for port 6543 automatically).
# Keep these ONLY in backend/.env — never in frontend code or VITE_ variables.
SUPABASE_DB_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DIRECT_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# Optional pool/connect tuning
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# Leave empty to fall back to local SQLite: sqlite:///career_guidance.db
#
# Test the connection and create missing tables:
#   cd backend && python check_db.py --create-tables

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ========================= FRONTEND (frontend/.env) =========================
# Vite only exposes variables prefixed with VITE_ to client-side code.

VITE_API_BASE_URL=http://localhost:5000/api
