# ============================================================
# Backend (Flask) environment variables
# Copy this file to backend/.env and fill in real values.
# .env is git-ignored — never commit real secrets.
# ============================================================

# ---- Flask ----
FLASK_APP=run.py
FLASK_ENV=development
# Optional dev-server binding (defaults shown)
# API_HOST=127.0.0.1
# API_PORT=5000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ---- JWT ----
# Use a random value of at least 32 characters (HS256).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-different-random-string
# Access-token lifetime in seconds (default: 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600
# Browser authentication uses an HttpOnly cookie plus a CSRF companion cookie.
# Keep secure=true behind HTTPS in production. For a frontend and API on
# different sites, also set JWT_COOKIE_SAMESITE=None with secure=true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true
# Persistent for the token lifetime; set true for a browser-session cookie.
JWT_SESSION_COOKIE=false

# ---- Database (Supabase PostgreSQL) ----
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the "Shared pooler" connection strings (IPv4-friendly).
#
# 1) Runtime: transaction mode, port 6543.
# 2) Schema/migrations: session mode, port 5432.
#
# Replace <PASSWORD> and <PROJECT-REF>. Keep the "postgresql+psycopg://" prefix
# and URL-encode special characters in the password (e.g. "@" -> "%40").
# Do NOT append Prisma's "?pgbouncer=true" — psycopg rejects that parameter;
# prepared statements are disabled automatically for port 6543 in app/config.py.
# Keep these values ONLY in backend/.env — never in frontend code or VITE_ vars.
SUPABASE_DB_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DIRECT_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
# Optional pool/connect tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE_SECONDS=300
# DB_POOL_TIMEOUT_SECONDS=30
# DB_CONNECT_TIMEOUT_SECONDS=10
# NOTE: If SUPABASE_DB_URL is empty/unset, the app falls back to a local
# SQLite file (backend/instance/career_guidance.db) so you can run without Supabase.
#
# Verify the connection + tables after configuring:
#   python check_db.py --create-tables

# ---- CORS ----
# Comma-separated list of allowed origins (the Vite dev server).
# Credentials (the JWT cookie) and the X-CSRF-TOKEN header are allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
