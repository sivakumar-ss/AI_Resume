# ============================================================
# Frontend (Vite) environment variables
# Copy this file to frontend/.env — Vite only exposes vars prefixed VITE_.
# ============================================================

# Base URL of the Flask API. "/api" keeps requests same-origin in development
# through the Vite proxy configured in vite.config.js. For a separately hosted
# API use an absolute URL, e.g. https://api.example.com/api.
VITE_API_BASE_URL=/api

# Development proxy target used by Vite for /api requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
